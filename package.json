{
  "name": "dsh-web-custom-title",
  "description": "DSH Web 客户端插件：自定义新页面（无会话 Hero 区）的大标题与圆形图标。双击标题改名（保持原始字体样式），双击图标自选照片换图（圆形裁剪、持久保存）。",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "custom-title",
    "hero"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "assets",
    "src",
    "build-client.mjs",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
